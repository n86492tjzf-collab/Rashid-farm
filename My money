}


/* =====================
   تحديث الصفحة
===================== */

function render(){

let spent=getSpent();

let remaining=
data.income-spent;

let percentage=
data.income>0
?
(spent/data.income)*100
:
0;


document.getElementById(
"income"
).value=
data.income||"";


document.getElementById(
"incomeView"
).innerText=
money(data.income);


document.getElementById(
"spentView"
).innerText=
money(spent);


document.getElementById(
"remainingView"
).innerText=
money(remaining);


document.getElementById(
"countView"
).innerText=
data.expenses.length;


document.getElementById(
"percentageView"
).innerText=
percentage.toFixed(1)+"%";


document.getElementById(
"progressBar"
).style.width=
Math.min(
percentage,
100
)+"%";


/* المصروفات */

let list=
document.getElementById(
"expenseList"
);

list.innerHTML="";


data.expenses
.slice()
.reverse()
.forEach(
function(item,index){

let realIndex=
data.expenses.length-1-index;

list.innerHTML+=`

<div class="item">

<div class="item-top">

<span>
${item.category}
</span>

<span>
${money(item.amount)}
</span>

</div>

<div>
📝 ${item.description}
</div>

<div>
📅 ${item.date}
</div>

<button
class="red"
style="padding:8px"
onclick="deleteExpense(${realIndex})">

حذف

</button>

</div>

`;

});


document.getElementById(
"emptyExpenses"
).style.display=
data.expenses.length
?
"none"
:
"block";


/* الالتزامات */

let debts=
document.getElementById(
"debtList"
);

debts.innerHTML="";


data.debts.forEach(
function(debt,index){

debts.innerHTML+=`

<div class="item">

<b>🏦 ${debt.name}</b>

<br>

المتبقي:
${money(debt.balance)}

<br>

القسط:
${money(debt.payment)}

<button
class="red"
style="padding:8px"
onclick="deleteDebt(${index})">

حذف

</button>

</div>

`;

});


/* الفئات */

let categories=
buildCategories();

let categoryReport=
document.getElementById(
"categoryReport"
);

categoryReport.innerHTML="";


Object.keys(categories)
.forEach(
function(category){

categoryReport.innerHTML+=`

<div class="category-row">

<span>
${category}
</span>

<b>
${money(categories[category])}
</b>

</div>

`;

});


if(!Object.keys(categories).length){

categoryReport.innerHTML=
"لا توجد مصروفات حتى الآن.";

}

}


/* تشغيل البرنامج */

render();

</script>

</body>

</html>
