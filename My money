</td>

</tr>

`}

</tbody>

</table>


<h2>
📋 تفاصيل المصروفات
</h2>


<table>

<thead>

<tr>

<th>#</th>

<th>الفئة</th>

<th>الوصف</th>

<th>التاريخ</th>

<th>المبلغ</th>

</tr>

</thead>

<tbody>

${expensesHTML||`

<tr>

<td colspan="5">
لا توجد مصروفات
</td>

</tr>

`}

</tbody>

</table>


<h2>
🏦 الالتزامات والأقساط
</h2>


<table>

