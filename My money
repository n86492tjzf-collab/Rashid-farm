<body>


<div class="header">

<h1>💰 فلوسي</h1>

<p>
التقرير المالي الشخصي
</p>

</div>


<div class="summary">


<div class="box">

<div class="title">
الدخل الشهري
</div>

<div class="value">
${money(data.income)}
</div>

</div>


<div class="box">

<div class="title">
إجمالي المصروفات
</div>

<div class="value">
${money(spent)}
</div>

</div>


<div class="box">

<div class="title">
المتبقي
</div>

<div class="value">
${money(remaining)}
</div>

</div>


<div class="box">

<div class="title">
نسبة المصروف
</div>

<div class="value">
